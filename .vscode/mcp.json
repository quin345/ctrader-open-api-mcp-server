{
  "servers": {
    "ctrader": {
      "type": "stdio",
      "command": "ctrader-mcp-server",
      "cwd": "${workspaceFolder}",
      "env": {
        "CTRADER_CLIENT_ID": "${env:CTRADER_CLIENT_ID}",
        "CTRADER_CLIENT_SECRET": "${env:CTRADER_CLIENT_SECRET}",
        "CTRADER_ENVIRONMENT": "demo"
      }
    }
  }
}
