# Copy to .env and fill in real values.

# Required — from https://openapi.ctrader.com (your application credentials)
CTRADER_CLIENT_ID=
CTRADER_CLIENT_SECRET=

# Environment: demo (default) or live
CTRADER_ENVIRONMENT=demo

# Optional — pre-select a trading account (otherwise discovered at runtime)
CTRADER_ACCOUNT_ID=

# Optional — OAuth redirect URI (default: http://localhost:8080/callback)
CTRADER_REDIRECT_URI=http://localhost:8080/callback

# Optional — token storage path (default: ~/.ctrader_mcp_server/tokens.json)
# CTRADER_TOKEN_PATH=

# Optional — comma-separated toolsets to enable (default: all)
# CTRADER_TOOLSETS=auth,account,trading,market_data,streaming,diagnostics

# Optional — request timeout in seconds (default: 30)
# CTRADER_REQUEST_TIMEOUT=30
